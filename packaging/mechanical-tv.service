[Unit]
Description=Mechanical TV simulation studio
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mechanical-tv
Group=mechanical-tv
WorkingDirectory=/opt/mechanical-tv/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mechanical-tv/environment
ExecStart=/usr/bin/python3 -m mechanical_tv.server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mechanical-tv
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
TasksMax=64
CPUQuota=150%
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
