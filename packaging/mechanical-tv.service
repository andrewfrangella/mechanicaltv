[Unit]
Description=Mechanical TV HDMI capture (preview output)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mechanical-tv
Group=mechanical-tv
SupplementaryGroups=video
WorkingDirectory=/opt/mechanical-tv/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mechanical-tv/environment
ExecStart=/usr/bin/python3 -m mechanical_tv.capture
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# V4L2 needs the host device namespace. Only video character devices are allowed.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-video4linux rw
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mechanical-tv
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=768M
TasksMax=64
CPUQuota=150%
Nice=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
